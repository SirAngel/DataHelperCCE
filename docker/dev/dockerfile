FROM codercom/code-server:latest

ENV PROJECT_PATH="/home/ubuntu/DataHelperCCE"
ENV VENV_PATH="/opt/venv"
ENV PATH="$VENV_PATH/bin:$PATH"

RUN sudo apt update && \
    sudo apt install -y python3 python3-pip python3-venv curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash - && \
    sudo apt install -y nodejs && \
    sudo rm -rf /var/lib/apt/lists/*

RUN sudo python3 -m venv $VENV_PATH && \
    sudo $VENV_PATH/bin/pip install --no-cache-dir \
    "streamlit>=1.32" \
    "anthropic>=0.40" \
    "pandas>=2.2" \
    "numpy>=1.26" \
    "plotly>=5.20" \
    "python-dotenv>=1.0" \
    "openpyxl>=3.1" \
    "fastapi>=0.110" \
    "uvicorn[standard]>=0.27" \
    "pydantic>=2.5" \
    "eval_type_backport>=0.2" \
    "boto3>=1.34" \
    "jupyter>=1.0" \
    "ipykernel>=6.29" \
    "scikit-learn>=1.4" \
    "pillow>=10.0" \
    "opencv-python-headless>=4.6.0" \
    "pyyaml>=6.0" \
    "psutil>=5.9" \
    "py-cpuinfo>=9.0" \
    "requests>=2.31" \
    "ultralytics-thop>=2.1.2" \
    "matplotlib>=3.8" \
    "seaborn>=0.13" \
    "tqdm>=4.66" \
    "polars>=0.20" \
    "nvidia-ml-py>=12.0" \
    "ultralytics>=8.4"

RUN sudo $VENV_PATH/bin/pip install --no-cache-dir \
    torch torchvision --index-url https://download.pytorch.org/whl/cpu

WORKDIR ${PROJECT_PATH}

COPY . ${PROJECT_PATH}

RUN code-server --install-extension ms-python.python && \
    code-server --install-extension dbaeumer.vscode-eslint && \
    code-server --install-extension esbenp.prettier-vscode

RUN code-server --install-extension amazonwebservices.aws-toolkit-vscode
RUN code-server --install-extension amazonwebservices.amazon-q-vscode

ENV CS_DISABLE_GETTING_STARTED_OVERRIDE=1

RUN mkdir -p /home/coder/.local/share/code-server/User && \
    echo '{"workbench.colorTheme":"Default Dark Modern","telemetry.telemetryLevel":"off","workbench.enableExperiments":false,"workbench.settings.enableNaturalLanguageSearch":false,"extensions.autoCheckUpdates":false,"extensions.autoUpdate":false,"update.mode":"none","npm.fetchOnlinePackageInfo":false,"aws.telemetry":false,"aws.suppressPrompts":{"codeWhispererConnectionExpired":true},"amazonQ.telemetry":false,"amazonQ.shareContentWithAWS":false}' > /home/coder/.local/share/code-server/User/settings.json

EXPOSE 8080

CMD ["code-server", "--bind-addr", "0.0.0.0:8080", "/home/ubuntu/DataHelperCCE/"]
